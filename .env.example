# ==============================================================================
# MediCare Environment Configuration Template
# Copy this file to .env and customize values for your deployment.
# All sensitive API keys are empty by default for safe repository hygiene.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Network & Gateway
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
DEBUG=false
LOG_LEVEL=INFO
GRACEFUL_SHUTDOWN_TIMEOUT=30

# ------------------------------------------------------------------------------
# Security & Authentication
# Optional shared secret for HTTP Bearer authentication on protected API endpoints.
# When set, protected endpoints require header: Authorization: Bearer <SERVICE_SECRET_KEY>
# ------------------------------------------------------------------------------
SERVICE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Foundational Model API Credentials (Commercial & Cloud Providers)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AWS_BEDROCK_ENABLED=false

# ------------------------------------------------------------------------------
# Local Inference & Self-Hosted Endpoints
# ------------------------------------------------------------------------------
LOCAL_MODEL_URL=http://localhost:8000/v1
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Model Defaults & Testing Toggles
# Set USE_MOCK_MODELS=true for deterministic zero-cost offline testing and benchmarks.
# Set USE_MOCK_MODELS=false and configure GROQ_API_KEY for live LLM inference.
# ------------------------------------------------------------------------------
USE_MOCK_MODELS=true
DEFAULT_AGENT=medicare-navigator
DEFAULT_MODEL=mock-gpt-4
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Persistence & Checkpointing
# ------------------------------------------------------------------------------
VAR_DIR=var
STORAGE_ENGINE=sqlite
SQLITE_PATH=var/platform.db
LANGGRAPH_CHECKPOINTER=memory
LANGGRAPH_CHECKPOINT_PATH=var/langgraph_checkpoints.db
POSTGRES_DSN=
MONGO_URI=

# ------------------------------------------------------------------------------
# MediCare & Claim Navigator Paths and Parameters
# ------------------------------------------------------------------------------
MEDICARE_DB_PATH=var/hospitals.db
MANIFEST_DB_PATH=var/manifest.db
POLICY_DOCS_DIR=data/policies
SEED_CSV_DIR=data/seed
CHROMA_PATH=var/chroma
CHROMA_COLLECTION=insurance_policies
CONFIG_DIR=config
AGENT_MAX_STEPS=6
SQL_MAX_RETRIES=3
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=5.0
RAG_TOP_K=5
MEDICARE_DEMO_FAIL_FIRST=false
HELPLINE_EMERGENCY=112
HELPLINE_MENTAL_HEALTH=14416 (Tele-MANAS)

# ------------------------------------------------------------------------------
# LangGraph Multi-Agent Runtime
# ------------------------------------------------------------------------------
GRAPH_RECURSION_LIMIT=40
GRAPH_TIMEOUT_SECONDS=90.0
MAX_LLM_CALLS_PER_RUN=14

# ------------------------------------------------------------------------------
# Supervisor Agent Configuration
# ------------------------------------------------------------------------------
SUPERVISOR_USE_LLM=true
SUPERVISOR_MIN_CONFIDENCE=0.55

# ------------------------------------------------------------------------------
# Multi-Format RAG & Hybrid Retrieval
# ------------------------------------------------------------------------------
EMBEDDING_BACKEND=chroma_default
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=120
RAG_DENSE_K=20
RAG_SPARSE_K=20
RAG_FETCH_K=12
RAG_MIN_RELEVANT=1
RAG_MAX_REWRITES=2
RAG_RRF_K=60
ENABLE_OCR=false

# ------------------------------------------------------------------------------
# User Document Uploads
# ------------------------------------------------------------------------------
UPLOAD_DIR=var/uploads
UPLOAD_MAX_MB=20
UPLOAD_MAX_PAGES=300
USER_DOCS_PER_USER_MAX=25

# ------------------------------------------------------------------------------
# Grounding Verifier
# ------------------------------------------------------------------------------
VERIFIER_ENABLED=true
VERIFIER_MAX_REGENERATIONS=1

# ------------------------------------------------------------------------------
# Optional External Tool Integrations
# ------------------------------------------------------------------------------
OPENWEATHER_API_KEY=
CLOUD_KB_ID=
REMOTE_MCP_URL=
REMOTE_MCP_TOKEN=

# ------------------------------------------------------------------------------
# Telemetry & Observability
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medicare
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# Client-Side Frontend Settings
# ------------------------------------------------------------------------------
STREAMLIT_PORT=8501
BACKEND_SERVICE_URL=http://localhost:8080
STT_PROVIDER=mock
TTS_PROVIDER=mock
