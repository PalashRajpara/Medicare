# ==============================================================================
# MediCare Git Ignore Policy
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Databases, Vector stores, Ingestion caches & Runtime state
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
medicare_data.db
data/*.db
data/chroma/
data/uploads/
var/
var/*
chroma/
scratch/

# Environment variables, credentials & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Testing & Coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Agent & Assistant artifacts
.gemini/
.agents/
.claude/
